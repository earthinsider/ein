---
layout: base.njk
title: "All Categories"
---
<main class="w-full pt-16 bg-surface min-h-screen">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
<div class="mb-10">
<h1 class="font-headline-xl text-[28px] sm:text-display-hero text-on-surface tracking-tight leading-none mb-3">Explore By Category</h1>
<p class="font-body-lead text-body-lead text-on-surface-variant">Browse every topic we cover on {{ site.name }}.</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
{% for cat in categories %}
<div class="p-6 rounded-2xl bg-surface-container-low shadow-sm">
<a href="/category/{{ cat.slug }}/" class="font-headline-lg text-headline-lg text-on-surface font-bold hover:text-primary transition-colors">{{ cat.label }}</a>
<div class="flex flex-wrap gap-2 mt-4">
{% for sub in cat.subs %}<a href="/category/{{ cat.slug }}/{{ sub.slug }}/" class="px-3 py-1 rounded-full bg-surface-container text-on-surface-variant hover:bg-primary hover:text-on-primary font-label-md text-label-md transition-colors">{{ sub.label }}</a>
{% endfor %}
</div>
</div>
{% endfor %}
</div>
</div>
</main>
