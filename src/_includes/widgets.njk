<aside aria-label="Network Notifications" class="fixed bottom-3 right-3 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-2 pointer-events-none [&>*]:pointer-events-auto">
<div id="widget-alerts" style="max-width:220px;min-width:180px" class="bg-surface-container-lowest rounded-xl p-2.5 sm:p-3 shadow-[0_8px_24px_rgba(0,0,0,0.12)] border border-outline-variant/40 border-l-[3px] border-l-primary flex items-center gap-2 relative">
<div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-primary-container/10 flex items-center justify-center text-primary shrink-0"><span class="material-symbols-outlined text-[16px] sm:text-[18px]">notifications_active</span></div>
<div class="flex-1 min-w-0 pr-4"><p class="font-label-md text-label-md text-on-surface font-semibold leading-tight truncate text-[12px] sm:text-[13px]">Get News Alerts</p><button class="widget-enable-btn text-label-xs font-label-xs text-primary font-semibold hover:underline text-[11px]" type="button">Enable</button></div>
<button aria-label="Close news alert" class="widget-close-btn absolute top-1.5 right-1.5 text-on-surface-variant hover:text-on-surface w-4 h-4 flex items-center justify-center rounded" data-widget="widget-alerts" data-persistent="true" type="button"><span class="material-symbols-outlined text-[12px]">close</span></button>
</div>
<div id="widget-telegram" style="max-width:220px;min-width:180px" class="bg-surface-container-lowest rounded-xl p-2.5 sm:p-3 shadow-[0_8px_24px_rgba(0,0,0,0.12)] border border-outline-variant/40 border-l-[3px] border-l-secondary flex items-center gap-2 relative">
<div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-secondary-container/20 flex items-center justify-center text-secondary shrink-0"><span class="material-symbols-outlined text-[16px] sm:text-[18px]">send</span></div>
<div class="flex-1 min-w-0 pr-4"><p class="font-label-md text-label-md text-on-surface font-semibold leading-tight truncate text-[12px] sm:text-[13px]">Join Telegram</p><a href="{{ site.social.telegram }}" class="inline-block text-label-xs font-label-xs text-secondary font-semibold hover:underline text-[11px]">Join now</a></div>
<button aria-label="Close Telegram prompt" class="widget-close-btn absolute top-1.5 right-1.5 text-on-surface-variant hover:text-on-surface w-4 h-4 flex items-center justify-center rounded" data-widget="widget-telegram" data-persistent="false" type="button"><span class="material-symbols-outlined text-[12px]">close</span></button>
</div>
<div id="widget-discord" style="max-width:220px;min-width:180px" class="bg-surface-container-lowest rounded-xl p-2.5 sm:p-3 shadow-[0_8px_24px_rgba(0,0,0,0.12)] border border-outline-variant/40 border-l-[3px] border-l-tertiary flex items-center gap-2 relative">
<div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-tertiary-container/20 flex items-center justify-center text-tertiary shrink-0"><span class="material-symbols-outlined text-[16px] sm:text-[18px]">forum</span></div>
<div class="flex-1 min-w-0 pr-4"><p class="font-label-md text-label-md text-on-surface font-semibold leading-tight truncate text-[12px] sm:text-[13px]">Join Discord</p><a href="{{ site.social.discord }}" class="inline-block text-label-xs font-label-xs text-tertiary font-semibold hover:underline text-[11px]">Join now</a></div>
<button aria-label="Close Discord prompt" class="widget-close-btn absolute top-1.5 right-1.5 text-on-surface-variant hover:text-on-surface w-4 h-4 flex items-center justify-center rounded" data-widget="widget-discord" data-persistent="false" type="button"><span class="material-symbols-outlined text-[12px]">close</span></button>
</div>
</aside>
<script>
(function(){
  var HOUR=60*60*1000;
  document.querySelectorAll('.widget-close-btn').forEach(function(btn){
    var id=btn.getAttribute('data-widget');
    var persistent=btn.getAttribute('data-persistent')==='true';
    var el=document.getElementById(id);
    if(!el)return;
    var key='ei_widget_'+id;
    if(!persistent){
      var t=localStorage.getItem(key);
      if(t&&(Date.now()-parseInt(t,10))<HOUR)el.style.display='none';
    } else {
      if(localStorage.getItem(key)==='subscribed')el.style.display='none';
    }
    btn.addEventListener('click',function(){
      el.style.display='none';
      if(!persistent)localStorage.setItem(key,Date.now().toString());
    });
  });
  document.querySelectorAll('.widget-enable-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      var el=document.getElementById('widget-alerts');
      if('Notification' in window)Notification.requestPermission();
      localStorage.setItem('ei_widget_widget-alerts','subscribed');
      if(el)el.style.display='none';
    });
  });
})();
</script>
