<aside aria-label="Network Notifications" class="fixed bottom-3 right-3 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-2 pointer-events-none [&>*]:pointer-events-auto">
<div id="widget-alerts" class="rounded-xl p-2.5 relative" style="max-width:180px;background:var(--c-surface-container-lowest);box-shadow:0 8px 24px rgba(0,0,0,0.12);border:1px solid rgba(0,0,0,0.08);border-left:3px solid var(--c-primary);display:flex;align-items:center;gap:8px">
<div class="rounded-lg shrink-0" style="width:26px;height:26px;background:var(--c-primary-container,#1f7a47);opacity:0.12;position:absolute"></div>
<span class="material-symbols-outlined shrink-0" style="font-size:16px;color:var(--c-primary);width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:rgba(0,96,51,0.08)">notifications_active</span>
<div class="flex-1" style="min-width:0;padding-right:16px">
<p class="font-label-md" style="font-size:11px;font-weight:600;color:var(--c-on-surface);line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Get News Alerts</p>
<button class="widget-enable-btn" style="font-size:10px;font-weight:600;color:var(--c-primary);background:none;border:none;padding:0;cursor:pointer" type="button">Enable</button>
</div>
<button aria-label="Close news alert" class="widget-close-btn" data-widget="widget-alerts" data-persistent="true" type="button" style="position:absolute;top:6px;right:6px;width:16px;height:16px;display:flex;align-items:center;justify-content:center;background:none;border:none;color:var(--c-on-surface-variant);cursor:pointer;padding:0"><span class="material-symbols-outlined" style="font-size:12px">close</span></button>
</div>
<div id="widget-telegram" class="rounded-xl p-2.5 relative" style="max-width:180px;background:var(--c-surface-container-lowest);box-shadow:0 8px 24px rgba(0,0,0,0.12);border:1px solid rgba(0,0,0,0.08);border-left:3px solid var(--c-secondary);display:flex;align-items:center;gap:8px">
<span class="material-symbols-outlined shrink-0" style="font-size:16px;color:var(--c-secondary);width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:rgba(45,98,141,0.08)">send</span>
<div class="flex-1" style="min-width:0;padding-right:16px">
<p class="font-label-md" style="font-size:11px;font-weight:600;color:var(--c-on-surface);line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Join Telegram</p>
<a href="{{ site.social.telegram }}" style="font-size:10px;font-weight:600;color:var(--c-secondary);text-decoration:none">Join now</a>
</div>
<button aria-label="Close Telegram prompt" class="widget-close-btn" data-widget="widget-telegram" data-persistent="false" type="button" style="position:absolute;top:6px;right:6px;width:16px;height:16px;display:flex;align-items:center;justify-content:center;background:none;border:none;color:var(--c-on-surface-variant);cursor:pointer;padding:0"><span class="material-symbols-outlined" style="font-size:12px">close</span></button>
</div>
<div id="widget-discord" class="rounded-xl p-2.5 relative" style="max-width:180px;background:var(--c-surface-container-lowest);box-shadow:0 8px 24px rgba(0,0,0,0.12);border:1px solid rgba(0,0,0,0.08);border-left:3px solid var(--c-tertiary);display:flex;align-items:center;gap:8px">
<span class="material-symbols-outlined shrink-0" style="font-size:16px;color:var(--c-tertiary);width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:rgba(139,55,66,0.08)">forum</span>
<div class="flex-1" style="min-width:0;padding-right:16px">
<p class="font-label-md" style="font-size:11px;font-weight:600;color:var(--c-on-surface);line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Join Discord</p>
<a href="{{ site.social.discord }}" style="font-size:10px;font-weight:600;color:var(--c-tertiary);text-decoration:none">Join now</a>
</div>
<button aria-label="Close Discord prompt" class="widget-close-btn" data-widget="widget-discord" data-persistent="false" type="button" style="position:absolute;top:6px;right:6px;width:16px;height:16px;display:flex;align-items:center;justify-content:center;background:none;border:none;color:var(--c-on-surface-variant);cursor:pointer;padding:0"><span class="material-symbols-outlined" style="font-size:12px">close</span></button>
</div>
</aside>
<script>
(function(){
  var HOUR=60*60*1000;
  document.querySelectorAll('.widget-close-btn').forEach(function(btn){
    var id=btn.getAttribute('data-widget');
    var persistent=btn.getAttribute('data-persistent')==='true';
    var el=document.getElementById(id);
    if(!el)return;
    var key='ei_widget_'+id;
    if(!persistent){
      var t=localStorage.getItem(key);
      if(t&&(Date.now()-parseInt(t,10))<HOUR)el.style.display='none';
    } else {
      if(localStorage.getItem(key)==='subscribed')el.style.display='none';
    }
    btn.addEventListener('click',function(){
      el.style.display='none';
      if(!persistent)localStorage.setItem(key,Date.now().toString());
    });
  });
  document.querySelectorAll('.widget-enable-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      var el=document.getElementById('widget-alerts');
      if('Notification' in window)Notification.requestPermission();
      localStorage.setItem('ei_widget_widget-alerts','subscribed');
      if(el)el.style.display='none';
    });
  });
})();
</script>
