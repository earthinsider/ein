<script>
function toggleTheme(){var d=document.documentElement.classList.toggle('dark');localStorage.setItem('ei_theme',d?'dark':'light');document.querySelectorAll('.theme-icon').forEach(function(e){e.textContent=d?'light_mode':'dark_mode'});}
document.addEventListener('DOMContentLoaded',function(){var d=document.documentElement.classList.contains('dark');document.querySelectorAll('.theme-icon').forEach(function(e){e.textContent=d?'light_mode':'dark_mode';});});
</script>
