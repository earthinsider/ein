<meta property="og:type" content="{% if templateClass == 'post' %}article{% else %}website{% endif %}"/>
<meta property="og:url" content="{{ site.url }}{{ page.url }}"/>
{% if image %}<meta property="og:image" content="{{ image }}"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content="{{ image }}"/>{% endif %}
