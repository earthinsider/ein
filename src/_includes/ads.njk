{# Adsterra — 160x600 skyscraper, desktop-only (fires only at lg+ width so it never
   loads on mobile, where a tall narrow banner performs poorly and would also risk
   viewport overflow). Best used once per page, in a sticky sidebar slot. #}
{% macro skyscraper160x600() %}
<div class="ad-slot" style="text-align:center;">
<script>
if (window.matchMedia('(min-width: 992px)').matches) {
  window.atOptions = {'key':'d9d74dbd11a016ff433ffb8f6839bcc0','format':'iframe','height':600,'width':160,'params':{}};
  var s = document.createElement('script');
  s.src = 'https://hystericallikingdowntown.com/d9d74dbd11a016ff433ffb8f6839bcc0/invoke.js';
  document.currentScript.parentNode.insertBefore(s, document.currentScript.nextSibling);
}
</script>
</div>
{% endmacro %}

{# Adsterra — Native Banner. IMPORTANT: this exact zone must render on the page ONCE ONLY
   across the whole site load — duplicating it renders a blank/failed slot the second
   time. Use on the homepage only. #}
{% macro nativeBanner() %}
<div class="ad-slot">
<script async="async" data-cfasync="false" src="https://hystericallikingdowntown.com/6810d457285656dc514536aeea46e59f/invoke.js"></script>
<div id="container-6810d457285656dc514536aeea46e59f"></div>
</div>
{% endmacro %}
