<header class="fixed top-0 w-full z-50 backdrop-blur-xl border-b border-outline-variant/30 shadow-[0_1px_8px_rgba(0,0,0,0.04)]" style="background-color:color-mix(in srgb, var(--c-surface) 95%, transparent)">
  <div class="h-14 max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 flex items-center gap-2">
    <!-- Logo -->
    <a class="flex items-center shrink-0 mr-2" href="/">
      <img alt="{{ site.shortName }}" class="h-7 sm:h-8 w-auto object-contain" src="{{ site.logo }}" loading="eager" fetchpriority="high"/>
    </a>
    <!-- Desktop nav -->
    <nav aria-label="Main navigation" class="hidden lg:flex items-center gap-5 xl:gap-7 flex-1">
      {% for cat in categories | limit(5) %}<a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors whitespace-nowrap" href="/category/{{ cat.slug }}/">{{ cat.label }}</a>{% endfor %}
      <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" href="/all-posts/">All Posts</a>
      <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" href="/all-categories/">Categories</a>
      <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" href="/about/">About</a>
    </nav>
    <!-- Spacer on mobile -->
    <div class="flex-1 lg:hidden"></div>
    <!-- Right controls: search + dark toggle (visible on mobile too) + hamburger -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Search: icon only on mobile, bar on desktop -->
      <a aria-label="Search" href="/search/" class="flex w-9 h-9 lg:hidden items-center justify-center rounded-lg bg-surface-container text-on-surface-variant hover:text-on-surface border border-outline-variant/30 transition-colors">
        <span class="material-symbols-outlined text-[18px]">search</span>
      </a>
      <a aria-label="Search publication" href="/search/" class="hidden lg:flex items-center gap-2 h-9 px-3 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-all border border-outline-variant/30">
        <span class="material-symbols-outlined text-[18px]">search</span>
        <span class="font-body-sm text-body-sm text-on-surface-variant/80">Search...</span>
        <kbd class="hidden xl:inline-flex items-center px-1.5 py-0.5 rounded bg-surface-container-highest text-on-surface font-label-xs text-label-xs border border-outline-variant/50">⌘K</kbd>
      </a>
      <!-- Dark/light toggle — visible everywhere -->
      <button aria-label="Toggle color mode" onclick="toggleTheme()" class="flex w-9 h-9 items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-colors border border-outline-variant/30" type="button">
        <span class="material-symbols-outlined text-[18px] theme-icon">dark_mode</span>
      </button>
      <!-- Hamburger — mobile only -->
      <button aria-label="Open menu" aria-expanded="false" id="menu-btn" class="lg:hidden flex w-9 h-9 items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-colors" onclick="toggleMenu()" type="button">
        <span class="material-symbols-outlined text-[20px]" id="menu-icon">menu</span>
      </button>
    </div>
  </div>
  <!-- Mobile drawer — full-width below header -->
  <div class="hidden lg:hidden bg-surface border-t border-outline-variant/30" id="mobile-drawer">
    <div class="max-w-7xl mx-auto px-4 py-3 pb-4">
      <!-- Search bar in drawer -->
      <div class="relative mb-3">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] pointer-events-none">search</span>
        <input class="w-full h-10 pl-10 pr-4 rounded-lg bg-surface-container text-on-surface text-body-sm placeholder:text-on-surface-variant/70 border border-outline-variant/30 focus:outline-none focus:ring-1 focus:ring-primary" placeholder="Search news..." type="text" onkeydown="if(event.key==='Enter'){window.location.href='/search/?q='+encodeURIComponent(this.value);toggleMenu()}"/>
      </div>
      <nav aria-label="Mobile navigation" class="grid grid-cols-2 gap-1">
        {% for cat in categories %}<a class="px-3 py-2.5 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-high transition-colors" href="/category/{{ cat.slug }}/">{{ cat.label }}</a>{% endfor %}
        <a class="px-3 py-2.5 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-high transition-colors" href="/all-posts/">All Posts</a>
        <a class="px-3 py-2.5 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-high transition-colors" href="/all-categories/">Categories</a>
        <a class="px-3 py-2.5 col-span-2 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-high transition-colors" href="/about/">About</a>
      </nav>
    </div>
  </div>
</header>
<script>
function toggleMenu(){
  var d=document.getElementById('mobile-drawer');
  var i=document.getElementById('menu-icon');
  var b=document.getElementById('menu-btn');
  var open=d.classList.toggle('hidden');
  i.textContent=open?'menu':'close';
  b.setAttribute('aria-expanded',(!open).toString());
}
// Close menu on outside click
document.addEventListener('click',function(e){
  var drawer=document.getElementById('mobile-drawer');
  var btn=document.getElementById('menu-btn');
  if(!drawer||!btn)return;
  if(!drawer.contains(e.target)&&!btn.contains(e.target)&&!drawer.classList.contains('hidden')){
    drawer.classList.add('hidden');
    document.getElementById('menu-icon').textContent='menu';
    btn.setAttribute('aria-expanded','false');
  }
});
</script>
