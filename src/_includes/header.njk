<header class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-xl border-b border-outline-variant/30 shadow-[0_1px_8px_rgba(0,0,0,0.03)]"><div class="h-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-space-md"><div class="flex items-center gap-3 shrink-0"><a class="flex items-center gap-2.5 sm:gap-3" href="/"><img alt="{{ site.shortName }} Logo" class="h-7 sm:h-8 w-auto object-contain" src="{{ site.logo }}"/></a><div class="hidden xl:flex items-center ml-2 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-xs text-label-xs tracking-wider uppercase border border-outline-variant/40"><span class="inline-block w-1.5 h-1.5 rounded-full bg-primary mr-1.5"></span>{{ site.tagline }}</div></div><nav class="hidden lg:flex items-center gap-6 xl:gap-8">
{% for cat in categories | limit(5) %}<a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-1" href="/category/{{ cat.slug }}/">{{ cat.label }}</a>{% endfor %}
<a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-1" href="/all-posts/">All Posts</a>
<a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-1" href="/all-categories/">Categories</a>
<a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-1" href="/about/">About</a>
</nav><div class="flex items-center gap-2 sm:gap-3 shrink-0"><a aria-label="Search publication" href="/search/" class="hidden md:flex items-center gap-2 h-9 px-3 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-all border border-outline-variant/30 text-left"><span class="material-symbols-outlined text-[18px]">search</span><span class="inline font-body-sm text-body-sm text-on-surface-variant/80">Search...</span><kbd class="inline-flex items-center px-1.5 py-0.5 rounded bg-surface-container-highest text-on-surface font-label-xs text-label-xs border border-outline-variant/50">⌘K</kbd></button><button aria-label="Toggle color mode" onclick="document.documentElement.classList.toggle('dark')" class="hidden md:flex w-9 h-9 items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-colors border border-outline-variant/30" type="button"><span class="material-symbols-outlined text-[18px]">dark_mode</span></button><button aria-label="Open navigation menu" class="lg:hidden w-9 h-9 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-colors" onclick="document.getElementById('mobile-drawer').classList.toggle('hidden')" type="button"><span class="material-symbols-outlined text-[20px]">menu</span></button></div></div><!-- Mobile navigation drawer --><div class="hidden lg:hidden border-t border-outline-variant/30 bg-surface px-4 py-4 space-y-3" id="mobile-drawer"><div class="flex items-center gap-2 mb-3"><div class="relative flex-1"><span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span><input class="w-full pl-9 pr-3 py-2 rounded-lg bg-surface-container text-on-surface text-body-sm placeholder:text-on-surface-variant/70 border border-outline-variant/30 focus:outline-none" placeholder="Search dispatches..." type="text" onkeydown="if(event.key==='Enter'){window.location.href='/search/?q='+encodeURIComponent(this.value)}"/></div><button aria-label="Toggle color mode" onclick="document.documentElement.classList.toggle('dark')" class="w-9 h-9 flex items-center justify-center rounded-lg bg-surface-container text-on-surface-variant border border-outline-variant/30" type="button"><span class="material-symbols-outlined text-[18px]">dark_mode</span></button></div><div class="flex flex-col gap-1">
{% for cat in categories %}<a class="px-3 py-2 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-colors" href="/category/{{ cat.slug }}/">{{ cat.label }}</a>{% endfor %}
<a class="px-3 py-2 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-colors" href="/all-posts/">All Posts</a>
<a class="px-3 py-2 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-colors" href="/all-categories/">Categories</a>
<a class="px-3 py-2 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-colors" href="/about/">About</a>
</div></div></header>