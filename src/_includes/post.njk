---
layout: base.njk
templateClass: post
---
{% import "macros.njk" as macros %}
{% import "ads.njk" as ads %}
<div class="fixed top-14 left-0 w-full h-0.5 z-40" style="background:var(--c-surface-container)"><div class="h-full bg-primary w-0 transition-all duration-150 ease-out" id="read-progress"></div></div>
<main class="w-full pt-14 bg-surface min-h-screen">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
<div class="flex flex-col w-full">
<header class="w-full mb-6">
<!-- Breadcrumb: Home > Category only (no full title to prevent overflow) -->
<nav class="flex items-center gap-1.5 font-label-xs text-label-xs text-on-surface-variant uppercase tracking-wider mb-3 flex-wrap">
<a class="hover:text-primary transition-colors shrink-0" href="/">Home</a>
<span class="material-symbols-outlined text-[12px] shrink-0">chevron_right</span>
<a class="hover:text-primary transition-colors shrink-0" href="/category/{{ categorySlug }}/">{{ categoryLabel }}</a>
</nav>
<!-- Title: full width, no overflow -->
<h1 class="font-display-hero text-[28px] sm:text-[36px] lg:text-display-hero text-on-surface tracking-tight leading-tight mb-4" style="word-break:break-word;overflow-wrap:break-word;">{{ title }}</h1>
<!-- Meta bar: stacks on mobile -->
<div class="flex flex-wrap items-center gap-2 mb-4">
<span class="px-2.5 py-0.5 rounded-full font-label-xs text-label-xs font-bold uppercase tracking-wider" style="background:var(--c-primary-fixed);color:var(--c-on-primary-fixed)">{{ categoryLabel }}</span>
<span style="width:4px;height:4px;border-radius:50%;background:var(--c-outline);display:inline-block;flex-shrink:0"></span>
<time class="font-label-md text-label-md text-on-surface-variant" datetime="{{ page.date | isoDate }}">{{ page.date | dateDisplay }}</time>
<span style="width:4px;height:4px;border-radius:50%;background:var(--c-outline);display:inline-block;flex-shrink:0"></span>
<span class="flex items-center gap-1 font-label-md text-label-md text-on-surface-variant"><span class="material-symbols-outlined text-[14px]">schedule</span> {{ content | readingTime }} min read</span>
</div>
{% if excerpt %}<p class="font-body-lead text-body-lead text-on-surface-variant mb-6 leading-relaxed" style="word-break:break-word">{{ excerpt }}</p>{% endif %}
{% if image %}<div class="w-full rounded-xl overflow-hidden mb-4" style="aspect-ratio:16/9;background:var(--c-surface-container-highest)">
<img src="{{ image }}" alt="{{ imageAlt or title }}" class="w-full h-full object-cover" width="1200" height="630" fetchpriority="high" loading="eager" decoding="async"/>
</div>{% endif %}
<!-- Share bar: simple row, wraps on mobile -->
<div class="flex flex-wrap items-center gap-2 py-3 px-4 rounded-xl mb-2" style="background:var(--c-surface-container-low)">
<span class="font-label-xs text-label-xs text-on-surface-variant uppercase tracking-wider">Share</span>
<a aria-label="Share on X" id="share-x" href="#" target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" style="background:var(--c-surface-container-lowest)"><span class="material-symbols-outlined text-[16px]">close</span></a>
<a aria-label="Share on Telegram" id="share-tg" href="#" target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" style="background:var(--c-surface-container-lowest)"><span class="material-symbols-outlined text-[16px]">send</span></a>
<a aria-label="Share on WhatsApp" id="share-wa" href="#" target="_blank" rel="noopener noreferrer" class="w-8 h-8 flex items-center justify-center rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" style="background:var(--c-surface-container-lowest)"><span class="material-symbols-outlined text-[16px]">chat</span></a>
<div class="relative">
<button aria-label="Copy link" id="copy-btn" type="button" class="w-8 h-8 flex items-center justify-center rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" style="background:var(--c-surface-container-lowest)"><span class="material-symbols-outlined text-[16px]">link</span></button>
<span id="copy-tip" class="opacity-0 pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded font-label-xs text-label-xs whitespace-nowrap transition-opacity" style="background:var(--c-inverse-surface);color:var(--c-inverse-on-surface)">Copied!</span>
</div>
<button aria-label="Save article" id="bookmark-btn" type="button" class="w-8 h-8 flex items-center justify-center rounded-lg text-on-surface-variant hover:text-primary transition-colors" style="background:var(--c-surface-container-lowest)"><span class="material-symbols-outlined text-[16px]" id="bookmark-icon">bookmark_border</span></button>
<button aria-label="Print" onclick="window.print()" type="button" class="w-8 h-8 flex items-center justify-center rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" style="background:var(--c-surface-container-lowest)"><span class="material-symbols-outlined text-[16px]">print</span></button>
</div>
</header>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start mb-16">
<article class="lg:col-span-8 flex flex-col min-w-0">
<details class="lg:hidden mb-8 bg-surface-container-low rounded-xl p-4 shadow-sm">
<summary class="font-headline-sm text-headline-sm font-bold text-on-surface cursor-pointer flex items-center justify-between list-none"><span class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-[20px]">format_list_bulleted</span> Article Outline</span><span class="material-symbols-outlined text-on-surface-variant">expand_more</span></summary>
<nav class="mt-4 flex flex-col space-y-2.5 pt-3" id="toc-nav-mobile"></nav>
</details>
<div class="flex gap-8 items-start">
<aside class="hidden xl:block w-56 shrink-0 sticky top-24 pt-1">
<div class="bg-surface-container-low rounded-xl p-4 shadow-sm">
<span class="font-label-xs text-label-xs uppercase tracking-widest text-outline block mb-3 font-bold">Contents</span>
<ul class="space-y-3 font-body-sm text-body-sm" id="toc-nav"></ul>
</div>
</aside>
<div class="flex-1 min-w-0 max-w-prose space-y-7 text-on-surface font-body-default text-body-default leading-relaxed" id="article-body">
{{ content | safe }}
</div>
</div>

{{ ads.responsiveBanner() }}

<section class="bg-surface-container-lowest rounded-xl p-5 sm:p-6 mt-10 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
<div><h4 class="font-headline-sm text-headline-sm text-on-surface">Was this post helpful?</h4><p class="font-body-sm text-body-sm text-on-surface-variant">Your feedback shapes what we cover next.</p></div>
<div class="flex items-center gap-2" id="feedback-container">
<button class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary/10 text-primary font-label-md text-label-md hover:bg-primary hover:text-on-primary transition-colors" id="feedback-yes" type="button"><span class="material-symbols-outlined text-[18px]">thumb_up</span> Yes</button>
<button class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md hover:bg-surface-container-high transition-colors" id="feedback-no" type="button"><span class="material-symbols-outlined text-[18px]">thumb_down</span> No</button>
</div>
</section>

{% set related = collections.posts | whereCategory(categorySlug) %}
{% if related.length > 1 %}
<section class="mt-16">
<div class="flex items-center justify-between mb-6">
<h2 class="font-headline-lg text-headline-md text-on-surface font-bold">More on {{ categoryLabel }}</h2>
<a class="font-label-md text-label-md text-primary hover:underline flex items-center gap-1 font-semibold" href="/category/{{ categorySlug }}/">View all <span class="material-symbols-outlined text-[16px]">arrow_forward</span></a>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{% for post in related | limit(4) %}{% if post.url != page.url %}{{ macros.articleCard(post) }}{% endif %}{% endfor %}
</div>
</section>
{% endif %}
</article>
{% include "sidebar.njk" %}
</div>

<section class="mb-16">
<div class="flex items-center justify-between mb-8"><h2 class="font-headline-xl text-headline-xl text-on-surface font-bold tracking-tight">Latest from {{ site.shortName }}</h2><a class="font-label-md text-label-md text-primary hover:underline flex items-center gap-1 font-semibold" href="/all-posts/">View all <span class="material-symbols-outlined text-[16px]">arrow_forward</span></a></div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{% for post in collections.posts | reverse | limit(3) %}{{ macros.articleCard(post) }}{% endfor %}
</div>
</section>
</div>
</div>
</main>
<script>
(function() {
  // reading progress
  window.addEventListener('scroll', function() {
    var h = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    var bar = document.getElementById('read-progress');
    if (bar) bar.style.width = (h > 0 ? (document.documentElement.scrollTop / h) * 100 : 0) + '%';
  });

  // auto-generate table of contents from h2 headings inside the article body
  var body = document.getElementById('article-body');
  var tocList = document.getElementById('toc-nav');
  var tocMobile = document.getElementById('toc-nav-mobile');
  if (body && tocList) {
    var headings = body.querySelectorAll('h2');
    headings.forEach(function(h, i) {
      if (!h.id) h.id = 'section-' + i;
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.href = '#' + h.id;
      a.className = 'toc-link block text-on-surface-variant hover:text-primary transition-colors';
      a.textContent = h.textContent;
      li.appendChild(a);
      tocList.appendChild(li);
      if (tocMobile) {
        var a2 = a.cloneNode(true);
        a2.className = 'font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors';
        tocMobile.appendChild(a2);
      }
    });
    window.addEventListener('scroll', function() {
      var current = '';
      headings.forEach(function(h) {
        if (window.scrollY >= h.offsetTop - 140) current = h.id;
      });
      tocList.querySelectorAll('.toc-link').forEach(function(link) {
        if (link.getAttribute('href') === '#' + current) {
          link.classList.add('text-primary', 'font-semibold');
        } else {
          link.classList.remove('text-primary', 'font-semibold');
        }
      });
    });
  }

  // social share links
  var url = encodeURIComponent(window.location.href);
  var title = encodeURIComponent(document.title);
  var sx = document.getElementById('share-x');
  var stg = document.getElementById('share-tg');
  var swa = document.getElementById('share-wa');
  if (sx) sx.href = 'https://x.com/intent/tweet?text=' + title + '&url=' + url;
  if (stg) stg.href = 'https://t.me/share/url?url=' + url + '&text=' + title;
  if (swa) swa.href = 'https://api.whatsapp.com/send?text=' + title + '%20' + url;

  // copy link
  var copyBtn = document.getElementById('copy-btn');
  var copyTip = document.getElementById('copy-tip');
  if (copyBtn) copyBtn.addEventListener('click', function() {
    navigator.clipboard.writeText(window.location.href).catch(function(){});
    copyTip.classList.remove('opacity-0'); copyTip.classList.add('opacity-100');
    setTimeout(function(){ copyTip.classList.remove('opacity-100'); copyTip.classList.add('opacity-0'); }, 2000);
  });

  // bookmark with localStorage persistence
  var bookmarkBtn = document.getElementById('bookmark-btn');
  var bookmarkIcon = document.getElementById('bookmark-icon');
  var bmKey = 'ei_bookmark_' + window.location.pathname.replace(/\//g,'_');
  if (bookmarkBtn) {
    if (localStorage.getItem(bmKey)) {
      bookmarkIcon.textContent = 'bookmark';
      bookmarkBtn.classList.add('text-primary');
    }
    bookmarkBtn.addEventListener('click', function() {
      var saved = bookmarkIcon.textContent === 'bookmark';
      bookmarkIcon.textContent = saved ? 'bookmark_border' : 'bookmark';
      bookmarkBtn.classList.toggle('text-primary', !saved);
      if (saved) { localStorage.removeItem(bmKey); } else { localStorage.setItem(bmKey, '1'); }
    });
  }

  // Resize Blogger images: replace s16000 (raw full-size) with s1200 (fast web size)
  // and add lazy loading + alt text fallback to all article body images
  document.querySelectorAll('#article-body img').forEach(function(img, i) {
    // Resize: s16000 → s1200 (stays on Blogger CDN, much smaller file)
    if (img.src && img.src.includes('blogger.googleusercontent.com')) {
      img.src = img.src.replace(/\/s\d+\//, '/s1200/');
      if (img.srcset) img.srcset = img.srcset.replace(/\/s\d+\//g, '/s1200/');
    }
    // Lazy load all images except the first (which may be above-fold)
    if (i > 0) img.loading = 'lazy';
    img.decoding = 'async';
    // Accessibility: ensure alt text exists
    if (!img.alt || img.alt.trim() === '') {
      img.alt = document.querySelector('h1') ? document.querySelector('h1').textContent.trim() : 'Article image';
    }
  });

    // Belt-and-suspenders: disable Blogger's image anchor tags that open
  // the raw full-size image in the browser, causing unwanted page zoom.
  document.querySelectorAll('#article-body .separator a[imageanchor], #article-body .separator a').forEach(function(a) {
    a.addEventListener('click', function(e) { e.preventDefault(); });
    a.style.pointerEvents = 'none';
    a.style.cursor = 'default';
  });

  var yes = document.getElementById('feedback-yes'), no = document.getElementById('feedback-no');
  var voted = false;
  if (yes) yes.addEventListener('click', function(){ if(!voted){voted=true; yes.classList.add('bg-primary','text-on-primary');} });
  if (no) no.addEventListener('click', function(){ if(!voted){voted=true; no.classList.add('bg-error-container','text-error');} });
})();
</script>
