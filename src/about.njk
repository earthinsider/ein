<p class="font-body-lead text-body-lead text-on-surface-variant max-w-2xl">
          {{ site.description }} We aim for clear, practical, and honest guidance — noting where something depends on your specific situation instead of guessing.
        </p>
<div class="flex flex-wrap items-center gap-6 mt-8 pt-6 bg-surface-container/60 rounded-lg px-6 py-3">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[20px]">verified</span>
<span class="font-body-sm text-body-sm text-on-surface font-semibold">100% Independent Testing</span>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-secondary text-[20px]">science</span>
<span class="font-body-sm text-body-sm text-on-surface font-semibold">Peer-Reviewed By Specialists</span>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-tertiary text-[20px]">format_image_left</span>
<span class="font-body-sm text-body-sm text-on-surface font-semibold">Zero-Tracking Ethics</span>
</div>
</div>
</div>
</div>
