<div class="lg:col-span-8 flex flex-col space-y-12">
<!-- Section: Mission -->
<section class="flex flex-col space-y-6">
<h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">What We Cover</h2>
<p class="font-body-default text-body-default text-on-surface-variant max-w-prose">{{ site.description }}</p>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
{% for cat in categories | limit(6) %}
<a href="/category/{{ cat.slug }}/" class="bg-surface-container-lowest rounded-xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
<div class="w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4"><span class="material-symbols-outlined text-[22px]">{{ cat.icon or "label" }}</span></div>
<h3 class="font-headline-md text-headline-md text-on-surface mt-1 mb-2">{{ cat.label }}</h3>
</a>
{% endfor %}
</div>
</section>
<!-- Section: Testing Methodology & Affiliate Disclosure -->
<section class="flex flex-col space-y-6">
<div class="flex items-baseline justify-between">
<h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Product Testing &amp; Affiliate Disclosure</h2>
<span class="font-label-xs text-label-xs text-outline tracking-wider uppercase font-mono">02 // Integrity</span>
</div>
<div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm space-y-6">
<div class="flex items-start gap-4">
<div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center shrink-0 text-on-surface mt-1">
<span class="material-symbols-outlined text-[20px]">shopping_bag</span>
</div>
<div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">We Do Not Accept Paid Placements or Free Seed Units</h3>
<p class="font-body-default text-body-default text-on-surface-variant leading-relaxed">
                All reviewed seeds, equipment, pressure washers, composting urns, and cast iron cookware are purchased anonymously through everyday consumer retail channels using our corporate operational testing budget. We categorically reject free manufacturer review units, sponsored placement deals, and pre-release VIP seeding to guarantee our impressions match what you unbox.
              </p>
</div>
</div>
<div class="flex items-start gap-4 pt-4 bg-surface-container-low/40 rounded-xl p-6">
<div class="w-10 h-10 rounded-lg bg-secondary-container/30 text-secondary flex items-center justify-center shrink-0 mt-1">
<span class="material-symbols-outlined text-[20px]">link</span>
</div>
<div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-2">Affiliate Revenue Mechanics</h3>
<p class="font-body-default text-body-default text-on-surface-variant leading-relaxed">
                When readers purchase through our contextual retail links, we may earn an affiliate commission. This never alters our evaluations: if a sustainable soap dispenser fails after three weeks or an heirloom seed batch yields suboptimal germination, we state it plainly, regardless of merchant partnerships. Our laboratory and editorial teams operate in absolute isolation from advertising sales.
              </p>
</div>
</div>
</div>
</section>
<!-- Section: Editorial Review Process -->
<section class="flex flex-col space-y-6">
<div class="flex items-baseline justify-between">
<h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">How We Research &amp; Review</h2>
</div>
<p class="font-body-default text-body-default text-on-surface-variant">Every guide on {{ site.name }} is researched from primary and reputable secondary sources, structured for clarity, and reviewed by our editorial process before publishing. Where information is uncertain or situation-dependent, we say so plainly rather than guessing.</p>
</section>
<!-- Section: Privacy & Data Ethics -->
<section class="flex flex-col space-y-6">
<div class="flex items-baseline justify-between">
<h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Privacy &amp; Data Protection Commitments</h2>
<span class="font-label-xs text-label-xs text-outline tracking-wider uppercase font-mono">04 // Privacy</span>
</div>
<div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm space-y-6">
<p class="font-body-default text-body-default text-on-surface-variant leading-relaxed">
            We believe an uncluttered life extends to digital boundaries. {{ site.name }} was engineered without invasive fingerprinting scripts, third-party pixel aggregators, or behavioral advertisement brokers.
          </p>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div class="p-4 rounded-lg bg-surface-container-low">
<div class="flex items-center gap-2 mb-2 text-primary">
<span class="material-symbols-outlined text-[20px]">cookie_off</span>
<h4 class="font-headline-sm text-headline-sm font-semibold">Zero Third-Party Ad Cookies</h4>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
                We do not auction reader behavioral logs. Your browsing paths through our composting guides stay completely private.
              </p>
</div>
<div class="p-4 rounded-lg bg-surface-container-low">
<div class="flex items-center gap-2 mb-2 text-primary">
<span class="material-symbols-outlined text-[20px]">mail_lock</span>
<h4 class="font-headline-sm text-headline-sm font-semibold">Non-Shared Mailing Database</h4>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
                Subscriber addresses are stored strictly in encrypted storage. We never trade, license, or sell community records.
              </p>
</div>
</div>
</div>
</section>
<!-- Section: Contact & Correction Form -->
<section class="flex flex-col space-y-6">
<div class="flex items-baseline justify-between">
<h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Report an Inaccuracy or Query the Desk</h2>
<span class="font-label-xs text-label-xs text-outline tracking-wider uppercase font-mono">05 // Contact</span>
</div>
<div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm">
<p class="font-body-sm text-body-sm text-on-surface-variant mb-6">
            If you identify a conflicting ratio, outdated botanical binomial, or chemical safety nuance, please notify our oversight team with supporting documentation. We issue logged transparent updates within 48 hours.
          </p>
<form class="space-y-4" id="correctionForm" onsubmit="event.preventDefault(); document.getElementById('formSuccess').classList.remove('hidden'); this.reset();">
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5" for="senderName">Your Name</label>
<input class="w-full h-11 px-3.5 rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline text-body-sm focus:outline-none focus:bg-surface-container-lowest shadow-inner transition-all" id="senderName" placeholder="e.g. Margaret Thorne" required="" type="text"/>
</div>
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5" for="senderEmail">Email Address</label>
<input class="w-full h-11 px-3.5 rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline text-body-sm focus:outline-none focus:bg-surface-container-lowest shadow-inner transition-all" id="senderEmail" placeholder="e.g. margaret@domain.org" required="" type="email"/>
</div>
</div>
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5" for="articleRef">Article Reference / URL</label>
<input class="w-full h-11 px-3.5 rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline text-body-sm focus:outline-none focus:bg-surface-container-lowest shadow-inner transition-all" id="articleRef" placeholder="e.g. Natural Borax Protocols (Guide #104)" type="text"/>
</div>
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5" for="notes">Correction Note or Query</label>
<textarea class="w-full p-3.5 rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline text-body-sm focus:outline-none focus:bg-surface-container-lowest shadow-inner transition-all" id="notes" placeholder="Please cite specific paragraph, botanical error, or lab study..." required="" rows="4"></textarea>
</div>
<div class="flex items-center justify-between pt-2">
<span class="font-label-xs text-label-xs text-on-surface-variant flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-primary">lock</span> Encrypted direct editorial queue
              </span>
<button class="px-6 py-2.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container hover:shadow-md transition-all" type="submit">
                Submit for Editorial Audit
              </button>
</div>
</form>
<div class="hidden mt-4 p-4 rounded-lg bg-primary/10 text-primary flex items-center gap-3" id="formSuccess">
<span class="material-symbols-outlined">check_circle</span>
<span class="font-body-sm text-body-sm">Thank you. Your inquiry has been routed to the Standards Desk. An editor will respond shortly.</span>
</div>
</div>
</section>
