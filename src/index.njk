---
layout: base.njk
title: ""
---
{% import "macros.njk" as macros %}
{% import "ads.njk" as ads %}
{% set latest = collections.posts | reverse %}
{% set featured = latest[0] %}
<main class="w-full pt-16 bg-surface min-h-screen">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-8">
<div class="flex flex-col w-full">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
<div class="lg:col-span-8 flex flex-col gap-8 sm:gap-12 min-w-0">

{% if featured %}
<article class="group relative bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
<a href="{{ featured.url }}">
<div class="relative aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden bg-surface-container-high">
<img class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]" alt="{{ featured.data.imageAlt or featured.data.title }}" src="{{ featured.data.image }}"/>
<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent"></div>
<div class="absolute top-3 left-3 sm:top-4 sm:left-4"><span class="inline-flex items-center px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-full bg-surface-container-lowest/90 backdrop-blur-md text-primary font-label-xs text-label-xs uppercase tracking-wider font-bold">Latest Guide</span></div>
<div class="absolute bottom-3 left-3 right-3 sm:bottom-6 sm:left-6 sm:right-6 text-on-primary">
<div class="flex flex-wrap items-center gap-1.5 sm:gap-2 mb-1.5 sm:mb-2 font-label-xs text-[10px] sm:text-label-xs uppercase tracking-widest text-on-primary/85">
<span class="text-primary-fixed font-bold">{{ featured.data.categoryLabel }}</span><span>•</span><span>{{ featured.templateContent | readingTime }} min read</span>
</div>
<h1 class="font-headline-xl text-[22px] leading-tight sm:text-headline-xl font-bold tracking-tight text-on-primary drop-shadow-sm max-w-2xl">{{ featured.data.title }}</h1>
</div>
</div>
</a>
<div class="p-4 sm:p-6 md:p-8 flex flex-col gap-4">
<p class="font-body-lead text-body-lead text-on-surface-variant max-w-[68ch]">{{ featured.data.excerpt }}</p>
<a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container transition-colors w-fit" href="{{ featured.url }}"><span>Read Full Guide</span><span class="material-symbols-outlined text-[18px]">arrow_forward</span></a>
</div>
</article>
{% endif %}

{{ ads.nativeBanner() }}
{{ ads.responsiveBanner() }}

<section class="flex flex-col gap-6">
<div class="flex items-end justify-between">
<div><span class="font-label-xs text-label-xs uppercase tracking-widest text-primary font-bold block mb-1">Dispatch Stream</span><h2 class="font-headline-lg text-headline-lg font-bold text-on-surface">Latest Articles</h2></div>
<a class="font-label-md text-label-md text-primary hover:text-primary-container inline-flex items-center gap-1 transition-colors" href="/all-posts/"><span>View all</span><span class="material-symbols-outlined text-[16px]">chevron_right</span></a>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{% for post in latest | limit(6) %}{{ macros.articleCard(post) }}{% endfor %}
</div>
</section>

{% for cat in site.categories | limit(3) %}
{% set catPosts = collections.posts | whereCategory(cat.slug) %}
{% if catPosts.length > 0 %}
<section class="flex flex-col gap-6">
<div class="flex items-center gap-3"><span class="w-2.5 h-6 rounded-full bg-primary inline-block"></span><h2 class="font-headline-xl text-headline-lg sm:text-headline-xl font-bold text-on-surface">{{ cat.label }}</h2></div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{% for post in catPosts | reverse | limit(3) %}{{ macros.articleCard(post) }}{% endfor %}
</div>
</section>
{% endif %}
{% endfor %}

</div>
{% include "sidebar.njk" %}
</div>
</div>
</div>
</main>
